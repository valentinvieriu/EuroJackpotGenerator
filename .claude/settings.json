{
  "env": {
    "NODE_ENV": "development"
  },
  "permissions": {
    "allow": [
      "Write",
      "MultiEdit",
      "Edit",
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "TodoRead",
      "TodoWrite"
    ],
    "deny": ["Bash(awk:*)"]
  },
  "features": {
    "extendedThinking": true,
    "toolUse": true,
    "codeExecution": true,
    "autoUpdates": true
  },
  "preferences": {
    "verbosity": "concise",
    "codeStyle": "modern-es",
    "testFirst": true,
    "lintBeforeCommit": true
  },
  "mcpServers": {
    "enableAllProjectMcpServers": true
  },
  "enabledMcpjsonServers": ["context7", "nuxt"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
